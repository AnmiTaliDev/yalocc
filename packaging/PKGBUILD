pkgname=yalocc
pkgver=@VERSION@
pkgrel=1
pkgdesc='Count blank, comment, and code lines in source files'
arch=('x86_64' 'aarch64')
url='@URL@'
license=('GPL-3.0-only')
depends=('glibc')
makedepends=('meson')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  meson setup build "$srcdir/$pkgname-$pkgver" --prefix=/usr --buildtype=plain
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
